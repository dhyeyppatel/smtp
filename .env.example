# ==============================================================================
# Database Configuration (MongoDB Atlas)
# ==============================================================================
# Atlas connection string (Database > Connect > Drivers)
MONGODB_URI=mongodb+srv://USER:PASSWORD@cluster0.xxxxx.mongodb.net/?retryWrites=true&w=majority
MONGODB_DB=otp_service

# Optional: Public URL of your deployed service (e.g. https://otp.dhyey.cc)
# Used for generating clean absolute unsubscribe links
APP_URL=https://otp.dhyey.cc

# ==============================================================================
# Security & Master API Keys
# ==============================================================================
# Master Key used to manage projects, create new API keys, and run global broadcasts
MASTER_API_KEY=master_secret_change_me_12345

# Any 32+ character random string for cryptographic OTP hashing & token signatures
OTP_SECRET=change-me-to-a-random-32-byte-hex-string

# Optional pre-seeded initial project API keys (created automatically on startup)
PROJECT_ABC_KEY=sk_abc_dev123
PROJECT_XYZ_KEY=sk_xyz_dev123

# ==============================================================================
# Default Platform SMTP Configuration (Fallback)
# ==============================================================================
# Phase 1: Personal Gmail (Free)
# Generate an App Password at: https://myaccount.google.com/apppasswords
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=your_personal_email@gmail.com
SMTP_PASSWORD=abcd efgh ijkl mnop
SMTP_FROM_EMAIL=your_personal_email@gmail.com
SMTP_FROM_NAME=Passcode

# Default fallback reply-to address (e.g. support@dhyey.cc)
# Individual projects can override this via their project settings or BYOS!
SMTP_REPLY_TO=support@dhyey.cc

# Phase 2: Future Business Email (e.g. Google Workspace @dhyey.cc)
# When you upgrade to Google Workspace for @dhyey.cc, simply update these lines:
# SMTP_USER=support@dhyey.cc
# SMTP_PASSWORD=your_google_workspace_app_password
# SMTP_FROM_EMAIL=support@dhyey.cc

# ==============================================================================
# Rate Limits & Queue Pacing
# ==============================================================================
OTP_TTL_MINUTES=5
RESEND_COOLDOWN_SECONDS=60
MAX_ATTEMPTS=5
IP_HOURLY_LIMIT=30

# Inter-email pacing delay for low-priority broadcast queue (in seconds)
# Keeps broadcast delivery safely below SMTP burst limits
BROADCAST_DELAY_SECONDS=1.2
